{
  "name": "pretext-image-engine",
  "description": "A configurable image-aware text layout engine built on Pretext.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Hilo-Hilo/pretext-image-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilo-Hilo/pretext-image-engine.git"
  },
  "bugs": {
    "url": "https://github.com/Hilo-Hilo/pretext-image-engine/issues"
  },
  "keywords": [
    "pretext",
    "image-layout",
    "text-wrap",
    "editorial-layout",
    "overlay-mask",
    "typescript"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "style": "./lib/styles.css",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./styles.css": "./lib/styles.css"
  },
  "sideEffects": [
    "./lib/styles.css"
  ],
  "files": [
    "lib",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "tsup src/lib/index.ts --format esm,cjs --dts --clean --out-dir lib && node scripts/copy-lib-assets.mjs",
    "build:demo": "vite build",
    "build": "npm run typecheck && npm run test && npm run build:lib && npm run build:demo",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "happy-dom": "^20.8.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4"
  }
}
