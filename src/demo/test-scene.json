      "lineHeight": 1.04,
      "gapAfter": 10,
      "allowMultiSlot": false,
      "letterSpacing": -0.6,
      "textTransform": "none",
      "highlight": {
        "enabled": false,
        "mode": "off"
      },
      "columns": {
        "mode": "off"
      }
    },
    "subhero": {
