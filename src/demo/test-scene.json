      "fontWeight": 300,
      "fontSizeRatio": 0.032,
      "minFontSize": 19,
      "maxFontSize": 28,
      "lineHeight": 1.22,
      "gapAfter": 12,
      "allowMultiSlot": false,
      "letterSpacing": 0,
      "textTransform": "none",
      "highlight": {
        "enabled": false,
        "mode": "off"
      },
      "columns": {
        "mode": "off"
      }
    },
    "body": {
      "fontFamily": "\"Helvetica Neue\", Arial, sans-serif",
      "fontWeight": 300,
      "fontSizeRatio": 0.028,
      "minFontSize": 18,
      "maxFontSize": 24,
      "lineHeight": 1.22,
      "gapAfter": 10,
      "allowMultiSlot": true,
      "letterSpacing": 0,
      "textTransform": "none",
      "highlight": {
        "enabled": false,
        "mode": "off"
      },
      "columns": {
        "mode": "off"
      }
    },
    "card": {
      "fontFamily": "\"Helvetica Neue\", Arial, sans-serif",
      "fontWeight": 300,
      "fontSizeRatio": 0.027,
      "minFontSize": 17,
      "maxFontSize": 23,
      "lineHeight": 1.24,
      "gapAfter": 10,
      "allowMultiSlot": true,
      "letterSpacing": 0,
      "textTransform": "none",
      "highlight": {
        "enabled": false,
        "mode": "off"
      },
      "columns": {
        "mode": "off"
      }
    },
    "footer": {
      "fontFamily": "\"Helvetica Neue\", Arial, sans-serif",
      "fontWeight": 300,
      "fontSizeRatio": 0.026,
      "minFontSize": 16,
      "maxFontSize": 22,
      "lineHeight": 1.24,
      "gapAfter": 8,
      "allowMultiSlot": false,
      "letterSpacing": 0,
      "textTransform": "none",
      "highlight": {
        "enabled": false,
        "mode": "off"
      },
      "columns": {
        "mode": "off"
      }
    }
  },
  "v2": {
    "enabled": true,
    "layout": {
      "gridColumns": 10,
      "gridRows": 8,
      "minCellScore": 0.36,
      "minSlotCells": 2,
