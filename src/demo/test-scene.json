        "mode": "static"
      },
      "v2": {
        "role": "eyebrow",
        "pinnedSlotId": "manual-upper-left",
        "backdrop": "none",
        "preferredTone": "light"
      }
    },
    {
      "id": "top-card",
      "style": "card",
      "region": "upperRight",
      "text": "Design systems, AI tooling, and product storytelling across image, interface, and brand experiences.",
      "scroll": {
        "mode": "static"
      },
      "v2": {
        "role": "body",
        "pinnedSlotId": "manual-upper-right",
        "backdrop": "panel",
        "preferredTone": "dark"
      }
    },
    {
