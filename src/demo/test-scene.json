{
  "meta": {
    "id": "local-test-scene",
    "name": "Local Test Scene",
    "description": "A high-resolution local test scene that uses ignored assets from public/scenes/local-test.",
    "alt": "A warm aerial view of the Bay Bridge leading into a hazy San Francisco skyline.",
    "author": "Hanson Wen",
    "tags": [
      "local-assets",
      "masked-layout",
      "reference-match",
      "test-site"
    ]
  },
  "assets": {
    "baseSrc": "/scenes/local-test/base.png",
    "overlaySrc": "/scenes/local-test/overlay-v2.png",
    "alphaThreshold": 20,
    "fit": "cover"
  },
  "stage": {
    "minHeight": 520,
    "background": "#080a0d",
    "padding": 14,
    "borderRadius": 32
  },
  "layout": {
    "outerPadding": 18,
    "horizontalPadding": 8,
    "verticalPadding": 3,
    "minSlotWidth": 56,
    "minScale": 0.68,
    "scaleStep": 0.08,
    "fallbackBelowWidth": 760
  },
  "resize": {
    "preserveFullText": false,
    "fallbackMode": "none",
    "fallbackLabel": "Keep text inside the image at this width."
  },
  "interaction": {
    "selectable": false
  },
  "colors": {
    "text": {
      "mode": "auto",
      "color": "#f4efe7",
      "lightColor": "#f4efe7",
      "darkColor": "#14181d",
      "luminanceThreshold": 0.61
    },
    "highlight": {
      "enabled": false,
      "mode": "off",
      "color": "rgba(11, 12, 15, 0.18)",
      "lightColor": "rgba(245, 240, 231, 0.24)",
      "darkColor": "rgba(10, 12, 16, 0.28)",
      "opacity": 0.2,
      "paddingX": 6,
      "paddingY": 3,
      "radius": 10,
      "blur": 18
    },
    "shadow": {
      "enabled": true,
      "color": "rgba(8, 10, 14, 0.22)",
      "blur": 10,
      "offsetX": 0,
      "offsetY": 4
    },
    "selection": {
      "enabled": true,
      "color": "#0d1117",
      "background": "rgba(247, 222, 183, 0.76)"
    }
  },
  "columnSplit": {
    "mode": "off",
    "preferredColumns": 1,
    "maxColumns": 1,
    "minColumnWidth": 180,
    "gap": 24,
    "applyToStyles": [
      "body"
    ]
  },
  "regions": {
    "upperLeft": {
      "xStart": 0.05,
      "xEnd": 0.28,
      "yStart": 0.05,
      "yEnd": 0.18,
      "anchorX": 0.1,
      "slotOrder": "left-to-right",
      "minSlotWidth": 72
    },
    "lowerLeft": {
      "xStart": 0.06,
      "xEnd": 0.46,
      "yStart": 0.54,
      "yEnd": 0.96,
      "anchorX": 0.15,
      "slotOrder": "left-to-right",
      "minSlotWidth": 80
    },
    "upperRight": {
      "xStart": 0.62,
      "xEnd": 0.96,
      "yStart": 0.05,
      "yEnd": 0.4,
      "anchorX": 0.78,
      "slotOrder": "center-out",
      "minSlotWidth": 92
    },
    "lowerRight": {
      "xStart": 0.62,
      "xEnd": 0.95,
      "yStart": 0.8,
      "yEnd": 0.96,
      "anchorX": 0.79,
      "slotOrder": "center-out",
      "minSlotWidth": 92
    }
  },
  "styles": {
    "eyebrow": {
      "fontFamily": "\"Helvetica Neue\", Arial, sans-serif",
      "fontWeight": 400,
      "fontSizeRatio": 0.028,
      "minFontSize": 18,
      "maxFontSize": 30,
      "lineHeight": 1.1,
      "gapAfter": 10,
      "allowMultiSlot": false,
      "letterSpacing": 0,
      "textTransform": "none",
      "highlight": {
        "enabled": false,
        "mode": "off"
      },
      "columns": {
        "mode": "off"
      }
    },
    "hero": {
