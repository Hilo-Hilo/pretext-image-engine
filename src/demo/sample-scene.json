{
  "meta": {
    "id": "san-francisco-bay",
    "name": "San Francisco Bay",
    "description": "A demo scene with two transparent openings and region-aware text placement.",
    "alt": "A hazy golden-hour view of the Bay Bridge leading toward the San Francisco skyline.",
    "author": "Hanson Wen",
    "tags": ["demo", "regions", "auto-color", "fallback"]
  },
  "assets": {
    "baseSrc": "/scenes/san-francisco/base.png",
    "overlaySrc": "/scenes/san-francisco/overlay.png",
    "alphaThreshold": 20,
    "fit": "cover"
  },
  "stage": {
    "minHeight": 420,
    "background": "#0b0e12",
    "padding": 12,
    "borderRadius": 28
  },
  "layout": {
    "outerPadding": 16,
    "horizontalPadding": 8,
    "verticalPadding": 2,
    "minSlotWidth": 52,
    "minScale": 0.68,
    "scaleStep": 0.08,
    "fallbackBelowWidth": 720
  },
  "resize": {
    "preserveFullText": true,
    "fallbackMode": "below",
    "fallbackLabel": "Full text moved below the image at this size."
  },
  "interaction": {
    "selectable": false
  },
  "colors": {
    "text": {
      "mode": "auto",
      "color": "#f8f1e7",
      "lightColor": "#f8f1e7",
      "darkColor": "#0f141a",
      "luminanceThreshold": 0.63
    },
    "highlight": {
      "enabled": true,
      "mode": "auto",
      "color": "rgba(8, 10, 15, 0.56)",
      "lightColor": "rgba(248, 241, 230, 0.9)",
      "darkColor": "rgba(8, 10, 15, 0.62)",
      "opacity": 0.9,
      "paddingX": 8,
      "paddingY": 4,
      "radius": 12,
      "blur": 22
    },
    "shadow": {
      "enabled": true,
      "color": "rgba(8, 10, 14, 0.42)",
      "blur": 16,
      "offsetX": 0,
      "offsetY": 6
    },
    "selection": {
      "enabled": true,
      "color": "#0d1117",
      "background": "rgba(245, 221, 171, 0.72)"
    }
  },
  "columnSplit": {
    "mode": "auto",
    "preferredColumns": 2,
    "maxColumns": 2,
    "minColumnWidth": 150,
    "gap": 22,
    "applyToStyles": ["body"]
  },
  "regions": {
    "sky": {
      "xStart": 0.52,
      "xEnd": 0.98,
      "yStart": 0.02,
      "yEnd": 0.48,
      "anchorX": 0.78,
      "slotOrder": "center-out",
      "minSlotWidth": 64
    },
    "water": {
      "xStart": 0.0,
      "xEnd": 0.73,
      "yStart": 0.48,
      "yEnd": 0.98,
      "anchorX": 0.24,
      "slotOrder": "left-to-right",
      "minSlotWidth": 52,
      "columnSplit": {
        "mode": "auto",
        "preferredColumns": 2,
        "maxColumns": 2,
        "minColumnWidth": 150,
        "gap": 20,
        "applyToStyles": ["body"]
      }
    }
  },
  "styles": {
    "eyebrow": {
      "highlight": {
        "enabled": false,
        "mode": "off"
      }
    },
    "heading": {
      "highlight": {
        "enabled": true,
        "mode": "pill",
        "paddingX": 10,
        "paddingY": 6,
        "radius": 14
      }
    }
  },
  "v2": {
    "enabled": true,
    "layout": {
      "gridColumns": 10,
      "gridRows": 8,
      "minCellScore": 0.36,
      "minSlotCells": 2,
      "subjectPadding": 12,
      "maxSlots": 2,
      "mobileSingleSlotBelow": 640,
      "preferWiderSlots": true
    },
    "subjectZones": [
      {
        "id": "bridge-subject",
        "x": 0.27,
        "y": 0.15,
        "width": 0.3,
        "height": 0.7,
        "padding": 0.02
      }
    ],
    "slots": [
      {
        "id": "manual-sky",
        "x": 0.58,
        "y": 0.08,
        "width": 0.28,
        "height": 0.26,
        "locked": true,
        "preferredRoles": ["headline", "eyebrow", "lede"]
      },
      {
        "id": "manual-water",
        "x": 0.08,
        "y": 0.58,
        "width": 0.4,
        "height": 0.22,
        "locked": true,
        "preferredRoles": ["body", "caption", "lede"]
      }
    ],
    "activeSlotIds": ["manual-sky", "manual-water"],
    "backdrop": {
      "mode": "panel",
      "panelOpacity": 0.84,
      "panelPadding": 16,
      "panelRadius": 22,
      "blur": 20,
      "tint": "rgba(10, 13, 19, 0.78)"
    },
    "colors": {
      "forceTone": "auto",
      "lightColor": "#f8f1e7",
      "darkColor": "#13202a",
      "accentColor": "#f5ddab"
    }
  },
  "blocks": [
    {
      "id": "eyebrow",
      "style": "eyebrow",
      "region": "sky",
      "text": "SAN FRANCISCO BAY",
      "scroll": {
        "mode": "reveal",
        "start": 0,
        "end": 0.3
      },
      "v2": {
        "role": "eyebrow",
        "pinnedSlotId": "manual-sky",
        "backdrop": "none"
      }
    },
    {
      "id": "headline",
      "style": "heading",
      "region": "sky",
      "text": "Bridge into haze.",
      "scroll": {
        "mode": "sticky-start-reveal",
        "start": 0.12,
        "end": 0.58,
        "stickyTop": 22
      },
      "v2": {
        "role": "headline",
        "pinnedSlotId": "manual-sky",
        "backdrop": "panel"
      }
    },
    {
      "id": "body",
      "style": "body",
      "region": "water",
      "text": "Two transparent regions keep the skyline and bridge in front while the copy lands in the cleared sky and water.",
      "scroll": {
        "mode": "reveal",
        "start": 0.45,
        "end": 1
      },
      "v2": {
        "role": "body",
        "pinnedSlotId": "manual-water",
        "backdrop": "panel"
      }
    }
  ]
}
